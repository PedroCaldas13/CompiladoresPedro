Package dplusplus;

Helpers
	digito = ['0'..'9'];
	minuscula = ['a'..'z'];
	maiuscula = ['A'..'Z'];
	letras = ['a'..'z'] | ['A'..'Z'];
	espaco = ' ';
		
	/* segundo a tabel ASCII esses sao os valores para
	   tabulacao, quebra de linha e retorno do carro */
	   
	nl = 10;   /* \n */
	tab = 9;   /* \t */
	rc = 13;   /* \r */
	
	
	
/* Palavras reservadas */
Tokens
	family = 'family';
	sim = 'yes';
	nao = 'no';
	answer = 'answer';
	number = 'number';
	start = 'start';
	finish = 'finish';
	procedure = 'procedure';
	abre_colchete = '[';
	fecha_colchete = ']';
	mais = '+';
	menos = '-';
	mult = '*';
	div = '/';
	object = 'object';
	unalterable = 'unalterable';
	function = 'function';
	in_case_that = 'in case that';
	aslongas = 'as long as';
	and = 'and';
	not = '!';
	or = 'or';
	maior_que = '>';
	menor_que = '<';
	igual = '=';
	atribuicao = '<<';
	par_esq = '(';
	par_dir = ')';
	ponto = '.';
	virgula = ',';
	separar_expressao = '|';
	e_comercial = '&';
	inteiro = digito+;
	real = digito+ '.' digito+; 
	
	/* aqui começam as incertezas */
	
	id = minuscula  (digito | letras | espaco)*;
	id_classe = maiuscula (digito | letras | espaco)*;
	espaco_em_branco = (espaco | nl | tab | rc )+;
	
	/* falta ver como faz esses comentarios de bloco e linha */
	
	comentario_linha = '--'  '\n';
	comentario_em_bloco= '-}';
	
 
Ignored Tokens
	espaco_em_branco,
	comentario_linha,
	comentario_em_bloco;
	
Productions
	ignore = {empty}; /* faz nada */
	 