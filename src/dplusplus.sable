Package dplusplus;

Helpers
	digito = ['0'..'9'];
	minuscula = ['a'..'z'];
	maiuscula = ['A'..'Z'];
	letras = ['a'..'z'] | ['A'..'Z'];
	espaco = ' ';
	all = [0 .. 0xffff];
	   
	nl = 10;   /* \n */
	tab = 9;   /* \t */
	rc = 13;   /* \r */
	
	
	
/* Palavras reservadas */
Tokens
	family = 'family';
	derives = 'derives';
	from = 'from';
	sim = 'yes';
	nao = 'no';
	answer = 'answer';
	number = 'number';
	start = 'start';
	finish = 'finish';
	procedure = 'procedure';
	abre_colchete = '[';
	fecha_colchete = ']';
	mais = '+';
	menos = '-';
	mult = '*';
	div = '/';
	object = 'object';
	unalterable = 'unalterable';
	alterable = 'alterable';
	function = 'function';
	in = 'in';
	case = 'case';
 	that = 'that';
	as = 'as';
	long = 'long';
	otherwise = 'otherwise';
	if = 'if';
	else = 'else';
	and = 'and';
	not = '!';
	or = 'or';
	maior_que = '>';
	menor_que = '<';
	igual = '=';
	atribuicao = '<<';
	ponto_entrada = '>>';
	par_esq = '(';
	par_dir = ')';
	ponto = '.';
	virgula = ',';
	separar_expressao = '|';
	e_comercial = '&';
	inteiro = digito+;
	real = digito+ '.' digito+; 
	
	id = minuscula  (digito | letras | '_')*;
	id_classe = maiuscula (digito | letras | '_')*;
	espaco_em_branco = (espaco | nl | tab | rc )+;
	
	comentario_linha = '--';
	abre_bloco = '{-';
	fecha_bloco = '-}';
	comentario_bloco = [all - ['-' + '}']];
	hifen = '-';
	chaves = '}';
	
 
Ignored Tokens
	espaco_em_branco,
	comentario_bloco,
	comentario_linha;
