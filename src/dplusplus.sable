Package dplusplus;

Helpers
	digito = ['0'..'9'];
	minuscula = ['a'..'z'];
	maiuscula = ['A'..'Z'];
	letras = ['a'..'z'] | ['A'..'Z'];
	espaco = ' ';
	all = [0 .. 0xffff];
	   
	nl = 10;   /* \n */
	tab = 9;   /* \t */
	rc = 13;   /* \r */
	nao_fim_de_linha = [all - [rc + nl]];
	

States
	normal,
	comentario;
	
	
/* Palavras reservadas */
Tokens
	{normal} family = 'family';
	{normal}derives = 'derives';
	{normal}from = 'from';
	{normal}sim = 'yes';
	{normal}nao = 'no';
	{normal}answer = 'answer';
	{normal}number = 'number';
	{normal}start = 'start';
	{normal}finish = 'finish';
	{normal}procedure = 'procedure';
	{normal}abre_colchete = '[';
	{normal}fecha_colchete = ']';
	{normal}mais = '+';
	{normal}menos = '-';
	{normal}mult = '*';
	{normal}div = '/';
	{normal}object = 'object';
	{normal}unalterable = 'unalterable';
	{normal}alterable = 'alterable';
	{normal}function = 'function';
	{normal}in = 'in';
	{normal}case = 'case';
 	{normal}that = 'that';
	{normal}as = 'as';
	{normal}long = 'long';
	{normal}otherwise = 'otherwise';
	{normal}if = 'if';
	{normal}else = 'else';
	{normal}and = 'and';
	{normal}not = '!';
	{normal}or = 'or';
	{normal}maior_que = '>';
	{normal}menor_que = '<';
	{normal}igual = '=';
	{normal}atribuicao = '<<';
	{normal}ponto_entrada = '>>';
	{normal}par_esq = '(';
	{normal}par_dir = ')';
	{normal}ponto = '.';
	{normal}virgula = ',';
	{normal}separar_expressao = '|';
	{normal}e_comercial = '&';
	{normal}inteiro = digito+;
	{normal}real = digito+ '.' digito+; 
	
	{normal}id = minuscula  (letras | '_')*;
	{normal}id_classe = maiuscula (letras | '_')*;
	{normal}espaco_em_branco = (espaco | nl | tab | rc )+;
	
	{normal} comentario_linha = '--' nao_fim_de_linha*;
	{normal->comentario} abre_bloco = '{-';
	{comentario->normal} fecha_bloco = '-}';
	{comentario} comentario_bloco = [all - ['-' + '}']]+ | '-' | '}';
	
 
Ignored Tokens
	espaco_em_branco,
	comentario_bloco,
	comentario_linha,
	abre_bloco,
	fecha_bloco;


Productions
	
